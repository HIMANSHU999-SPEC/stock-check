# Copy to ".env" next to this file on the server and fill in. The app reads it
# at start-up; real environment variables take precedence. Never commit .env.

# --- Core -------------------------------------------------------------------
# Secret used to sign login sessions. REQUIRED for single sign-on.
#   openssl rand -hex 32
AUTH_SECRET=

# Public address of this system, no trailing slash. Used for the Microsoft
# sign-in redirect and for the links inside printed QR stickers.
#   e.g. https://stock.example.ac.uk
APP_BASE_URL=

# Campus that electronics with no campus are filed under until moved on.
# HOME_CAMPUS=Towerhill

# --- AI categorising (optional) ----------------------------------------------
# An Anthropic API key turns on AI suggestions for asset categories and brands
# (Assets -> Tidy up, the asset form, and imports). Without it the built-in
# rules are used. Only asset names, models, brands and categories are sent.
#   Create a key at https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=
# Model to use. Leave unset for the default.
# AI_MODEL=claude-opus-5-5

# --- Microsoft 365 (one Entra app registration for all three features) -------
# See docs/MICROSOFT365_SETUP.md for where to find these.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Set to true once everyone signs in with Microsoft, to refuse passwords.
# DISABLE_PASSWORD_LOGIN=true

# --- Email (can also be set from Settings in the app) -----------------------
# Mailbox the system sends from, e.g. itsupport@example.ac.uk. Needs the
# Mail.Send application permission.
MAIL_FROM=
# Optional: copy every email to these addresses (comma separated).
# MAIL_CC=

# --- SharePoint list (can also be set from Settings in the app) --------------
# SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/IT
# SHAREPOINT_LIST_NAME=IT Asset Register

# Behind nginx, listen only on this machine so the API is not reachable directly.
# HOST=127.0.0.1
# Other websites allowed to call the API (comma separated). Leave unset: the web app is same-origin.
# CORS_ORIGIN=
